{
  "name": "tapt-mobile",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start -c",
    "android": "yarn expo run:android",
    "android:clean": "cd android && ./gradlew clean && cd .. && yarn expo run:android",
    "ios": "yarn expo run:ios",
    "build:android": "yarn expo build:android",
    "build:ios": "yarn expo build:ios",
    "eas:build:development": "eas build --profile development",
    "eas:build:preview": "eas build --profile preview",
    "eas:build:production": "eas build --profile production",
    "env:copy:dev": "cp .env.dev .env",
    "env:copy:qa": "cp .env.preview .env",
    "env:copy:prod": "cp .env.prod .env",
    "lint:fix": "eslint . --fix",
    "lint": "eslint .",
    "format:fix": "prettier --write .",
    "format": "prettier --check .",
    "test:unit": "env-cmd --file .env.test yarn jest",
    "test:watch": "env-cmd --file .env.test yarn jest --watch",
    "test:unit:update": " env-cmd --file .env.test jest --coverage -u --forceExit",
    "typecheck": "tsc --noemit"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/native": "^7.3.18",
    "@sentry/react-native": "~7.11.0",
    "@tabler/icons": "^3.46.0",
    "@tanstack/react-query": "^5.87.4",
    "axios": "^1.9.0",
    "expo": "~57.0.19",
    "expo-constants": "~57.0.17",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-localization": "~57.0.1",
    "expo-router": "~57.0.18",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-updates": "~57.0.21",
    "i18n-js": "^4.5.1",
    "lodash": "^4.17.21",
    "lucide": "^1.40.0",
    "lucide-react-native": "^0.511.0",
    "morphicons": "^1.7.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-dotenv": "^3.4.11",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-size-matters": "^0.4.2",
    "react-native-svg": "15.15.4",
    "react-native-svg-transformer": "^1.5.1",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-proposal-export-namespace-from": "^7.18.9",
    "@types/eslint-plugin-jsx-a11y": "^6",
    "@types/eslint-plugin-security": "^3",
    "@types/lodash": "^4",
    "@types/react": "~19.2.4",
    "@typescript-eslint/eslint-plugin": "^7.12.0",
    "@typescript-eslint/parser": "^7.12.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-react-native": "^4.1.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jest": "^28.8.3",
    "eslint-plugin-jsonc": "^2.20.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-native": "^4.1.0",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-testing-library": "^7.6.8",
    "eslint-plugin-unicorn": "48",
    "prettier": "^3.4.2",
    "typescript": "~6.0.3"
  },
  "engines": {
    "npm": "Unsupported. Use Yarn instead.",
    "yarn": ">= 4.6.0",
    "node": ">= 22.13.0"
  },
  "private": true,
  "packageManager": "yarn@4.9.1"
}
